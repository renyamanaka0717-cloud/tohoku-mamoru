# このファイルをコピーして .env.local という名前にしてください
# .env.local にはあなたの本物のAPIキーを入れます
# .env.local は絶対にGitHubにアップロードしないでください（.gitignoreで除外済み）

# Groq API キー（完全無料・クレカ不要・メールだけで登録できる）
# https://console.groq.com でAPIキーを取得してください
GROQ_API_KEY=your_api_key_here

# Firebase Analytics（Web/開発環境用。iOSネイティブはGoogleService-Info.plist経由で別途設定する）
# https://console.firebase.google.com でプロジェクトを作成 → ウェブアプリを追加 → 「SDKの設定と構成」に表示される値をコピー
# NEXT_PUBLIC_ プレフィックスのため値自体は秘密情報ではない（クライアントに埋め込まれる）が、
# Vercelにデプロイする場合はVercelのプロジェクト設定 → Environment Variablesにも同じ値を追加すること
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
