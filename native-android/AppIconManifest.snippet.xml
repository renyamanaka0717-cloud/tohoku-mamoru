<!-- android/app/src/main/AndroidManifest.xml の <application> タグ内、既存の <activity name=".MainActivity"> の
     直後に追加する。8色ぶんの<activity-alias>（MainActivityを指す「別名」コンポーネント）。
     android:name（.MainActivityAliasSage 等）はAppIconPlugin.ktのALIAS_SUFFIXESと完全に一致させること。
     android:icon/roundIconが指すmipmapリソース（ic_launcher_sage等）はAndroid Studioの
     Image Asset ウィザードで別途生成する必要がある（このスニペットには含まれない、手動作業）。
     全エイリアスは android:enabled="false" で開始する（デフォルトはMainActivity本体=mint）。 -->

<activity-alias
    android:name=".MainActivityAliasSage"
    android:enabled="false"
    android:icon="@mipmap/ic_launcher_sage"
    android:roundIcon="@mipmap/ic_launcher_sage_round"
    android:label="@string/app_name"
    android:targetActivity=".MainActivity"
    android:exported="true">
    <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
    </intent-filter>
</activity-alias>

