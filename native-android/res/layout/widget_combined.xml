<?xml version="1.0" encoding="utf-8"?>
<!-- android/app/src/main/res/layout/widget_combined.xml にコピーする -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- 次の予定 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_next_tasks_title"
            android:textSize="12sp"
            android:textColor="#9CA3AF" />

        <TextView
            android:id="@+id/empty_tasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/widget_no_tasks"
            android:textSize="12sp"
            android:textColor="#9CA3AF"
            android:visibility="gone" />

        <LinearLayout android:id="@+id/task_row_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:visibility="gone">
            <ImageView android:id="@+id/task_dot_0" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginTop="4dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot" />
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:id="@+id/task_time_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/task_name_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#1F2937" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/task_row_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:visibility="gone">
            <ImageView android:id="@+id/task_dot_1" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginTop="4dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot" />
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:id="@+id/task_time_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/task_name_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#1F2937" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/task_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:visibility="gone">
            <ImageView android:id="@+id/task_dot_2" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginTop="4dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot" />
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:id="@+id/task_time_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/task_name_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#1F2937" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/task_row_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:visibility="gone">
            <ImageView android:id="@+id/task_dot_3" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginTop="4dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot" />
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:id="@+id/task_time_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/task_name_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#1F2937" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="#E5E7EB" />

    <!-- 買い物リスト -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_shopping_title"
            android:textSize="12sp"
            android:textColor="#9CA3AF" />

        <TextView
            android:id="@+id/empty_shop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/widget_no_shop_items"
            android:textSize="12sp"
            android:textColor="#9CA3AF"
            android:visibility="gone" />

        <LinearLayout android:id="@+id/shop_row_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:visibility="gone" android:gravity="center_vertical">
            <ImageView android:id="@+id/shop_dot_0" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot" />
            <TextView android:id="@+id/shop_name_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#1F2937" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/shop_row_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:visibility="gone" android:gravity="center_vertical">
            <ImageView android:id="@+id/shop_dot_1" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot" />
            <TextView android:id="@+id/shop_name_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#1F2937" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/shop_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:visibility="gone" android:gravity="center_vertical">
            <ImageView android:id="@+id/shop_dot_2" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot" />
            <TextView android:id="@+id/shop_name_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#1F2937" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/shop_row_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:visibility="gone" android:gravity="center_vertical">
            <ImageView android:id="@+id/shop_dot_3" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot" />
            <TextView android:id="@+id/shop_name_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#1F2937" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/shop_row_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:visibility="gone" android:gravity="center_vertical">
            <ImageView android:id="@+id/shop_dot_4" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot" />
            <TextView android:id="@+id/shop_name_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#1F2937" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/shop_row_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:visibility="gone" android:gravity="center_vertical">
            <ImageView android:id="@+id/shop_dot_5" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot" />
            <TextView android:id="@+id/shop_name_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#1F2937" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
